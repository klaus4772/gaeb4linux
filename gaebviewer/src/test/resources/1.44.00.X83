             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schutzplanen aus engmaschigen Gewebe</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">am vorbeschriebenen Gerüst bespannen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Ausführung:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[ x ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;"> </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">200 g, weiß</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[  ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;">   </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">200 g, gitterverstärkt, transparent</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Plane:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[ x ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;"> </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">neu</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[ x ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;"> </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gebraucht</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auf- und Abbau inkl. An- und Abtransport, sowie aller erforderlichen Nebenarbeiten und Gebrauchsüberlassung von 4 Wochen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Höhe: </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ca. 12 m</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Verwendung: </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">z.B. Staub- und Windschutz</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">In diese Position ist die zusätzliche Verankerung des Gerüstes für die Aufnahme der zusätzlichen Windlasten aus der Verkleidung miteinzurechnen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schutzplanen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>

         <Item ID="AAAAAAABIDDHEONI" RNoPart="30">
          <Qty>2.000</Qty>
          <QU>Stk</QU>
          <Description ID="R20161005094701226822956">
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Podesttreppenturm mit Treppenläufen, Podestbereichen</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und allseitigem Seitenschutz.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Lastklasse:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[ x ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;"> </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">LK 3</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[  ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;">   </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">LK 4</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Verankerung:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[  ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;">   </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">freistehend</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[ x ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;"> </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">über das Fassadengerüst</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auf- und Abbau inkl. An- und Abtransport, sowie aller erforderlichen Nebenarbeiten und Gebrauchsüberlassung von 4 Wochen.</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Verwendung:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[ x ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;"> </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">z.B. Zugang zu den Gerüstebenen </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[  ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;">   </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">des Fassaden- + Raumgerüstes</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der Turm ist so aufzubauen, dass jede Gerüstlage direkt vom Turm aus zugänglich ist. </span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-weight:bold;font-size:10pt;Color:rgb(0,0,0);">Zugang zum Gerüst:</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">[ x ]</span>
               <span style="font-family:Arial;font-size:10;mso-tab-count:1;"> </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">seitlich</span>
              </p>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;tab-stops:6.90mm 49.90mm 56.90mm 76.90mm 83.90mm;">

[Unit]
Description=GAEB Viewer Web Application
After=network.target

[Service]
Type=simple
User=gaebviewer
Group=gaebviewer
WorkingDirectory=/opt/gaebviewer
ExecStart=/usr/bin/java -Xmx512m -Xms256m -jar /opt/gaebviewer/gaebviewer-0.1.0-SNAPSHOT.jar --server.port=8080
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gaebviewer

# Sicherheitseinstellungen
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gaebviewer/logs

[Install]
WantedBy=multi-user.target
